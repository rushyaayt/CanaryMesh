# CanaryMesh / Honeytoken-as-a-Service Environment Configuration

# Server Settings
CANARY_HOST=0.0.0.0
CANARY_PORT=8000
CANARY_PUBLIC_URL=http://localhost:8000
CANARY_SECRET_KEY=change-this-to-a-secure-random-32-byte-secret-key

# Database Settings (SQLite local file or URI)
CANARY_DATABASE_PATH=canarymesh.db

# Alert Webhook Settings (Optional default webhook for all tokens)
# Supports Slack incoming webhooks, Discord webhooks, or generic JSON endpoints
CANARY_DEFAULT_WEBHOOK_URL=

# API access keys (each key must be at least 32 characters)
CANARY_ADMIN_API_KEY=
CANARY_PREVIOUS_ADMIN_API_KEY=
CANARY_READONLY_API_KEY=

# AWS EventBridge webhook signature and expected honeytoken identity
CANARY_AWS_WEBHOOK_SECRET=
CANARY_AWS_ACCOUNT_ID=
CANARY_AWS_PRINCIPAL_ARN=

# Outbound webhook security. Allow only exact hosts you intentionally trust.
CANARY_WEBHOOK_ALLOWED_HOSTS=

# Optional multi-instance WebSocket fan-out and event retention
CANARY_REDIS_URL=
CANARY_RETENTION_DAYS=0

# Inbound AWS webhook limits
CANARY_WEBHOOK_RATE_LIMIT=60
CANARY_WEBHOOK_RATE_WINDOW_SECONDS=60
CANARY_WEBHOOK_MAX_BODY_BYTES=65536

# Forensic Settings
# Enable reverse IP geo/ASN resolution (uses ip-api fallback or offline mock)
CANARY_GEOIP_ENABLED=true
# Trust forwarding headers only behind a trusted proxy that overwrites them
CANARY_TRUST_PROXY_HEADERS=false

# Security & Deception Settings
CANARY_DECOY_DELAY_MS=120
